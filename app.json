{
  "expo": {
    "name": "WOMART by Womup",
    "slug": "womart",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/d05b7fce-0f74-4d20-8b8b-59b06b5cda95",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/WOMARTCUSTOMER.png",
      "resizeMode": "cover",
      "backgroundColor": "#FED2EB"
    },
    "plugins": [
      "expo-font",
      "expo-speech-recognition",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "WOMART needs your location to show nearby stores and deliver accurately."
        }
      ],
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "WOMART needs access to your photos to print documents and images."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WOMART to access your camera to scan vendor counter QR codes."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wormup.customerapp",
      "infoPlist": {
        "CFBundleDisplayName": "WOMART by Womup"
      }
    },
    "android": {
      "package": "com.wormup.customerapp",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#05062A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d05b7fce-0f74-4d20-8b8b-59b06b5cda95"
      }
    },
    "owner": "darshanthanki007"
  }
}
