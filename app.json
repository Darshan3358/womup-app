{
  "expo": {
    "name": "Worm Up",
    "slug": "worm-up-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/Wormup.png",
          "resizeMode": "contain",
          "backgroundColor": "#05062A"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wormup.customerapp",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#05062A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1d64c304-0e2d-4716-8301-de5ebd1d6900"
      }
    },
    "owner": "darshanthanki007"
  }
}
