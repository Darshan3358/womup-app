{
  "expo": {
    "name": "Worm Up",
    "slug": "worm-up-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/Wormup.png",
          "resizeMode": "contain",
          "backgroundColor": "#05062A"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wormup.customerapp",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#05062A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "88be2903-cd4c-4e04-904e-de239ec8dcfb"
      }
    },
    "owner": "darshanthanki007",
    "plugins": [
      "expo-font"
    ]
  }
}
