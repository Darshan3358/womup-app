{
  "expo": {
    "name": "Womup Admin Console",
    "slug": "womup-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/48151227-8b4b-48e3-8e1c-941787f381c8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/admin_splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#05062A"
    },
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.web3apk.womupadmin"
    },
    "android": {
      "package": "com.web3apk.womupadmin",
      "adaptiveIcon": {
        "backgroundColor": "#05062A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      }
    },
    "owner": "darshanthanki007",
    "extra": {
      "eas": {
        "projectId": "48151227-8b4b-48e3-8e1c-941787f381c8"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Wom Up needs access to your photos to upload product images.",
          "cameraPermission": "Wom Up needs access to your camera to take product photos."
        }
      ]
    ]
  }
}
