{
  "expo": {
    "name": "WOMART Admin Console",
    "slug": "womup-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": "1.0.0",
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/1f550986-a2d2-4b63-8afc-20425d58e185"
    },
    "splash": {
      "image": "./assets/admin_splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#05062A"
    },
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.web3apk.womupadmin",
      "infoPlist": {
        "CFBundleDisplayName": "WOMART Admin"
      }
    },
    "android": {
      "package": "com.web3apk.womupadmin",
      "adaptiveIcon": {
        "backgroundColor": "#05062A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "owner": "darshanthanki007",
    "extra": {
      "eas": {
        "projectId": "1f550986-a2d2-4b63-8afc-20425d58e185"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Wom Up needs access to your photos to upload product images.",
          "cameraPermission": "Wom Up needs access to your camera to take product photos."
        }
      ]
    ]
  }
}