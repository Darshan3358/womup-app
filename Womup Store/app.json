{
  "expo": {
    "name": "Worm Up Dark Store",
    "slug": "womup-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#05062A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.womup.store"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05062A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.womup.store",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Wom Up needs access to your photos to upload product images.",
          "cameraPermission": "Wom Up needs access to your camera to take product photos."
        }
      ]
    ]
  }
}
