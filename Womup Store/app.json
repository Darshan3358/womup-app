{
  "expo": {
    "name": "WOMART Store",
    "slug": "womart-store",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/2914feef-5f54-4157-b543-c428319fd864",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splashstorescreen.png",
      "resizeMode": "cover",
      "backgroundColor": "#071B52"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.womup.store",
      "infoPlist": {
        "CFBundleDisplayName": "WOMART Store"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05062A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.womup.store",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Wom Up needs access to your photos to upload product images.",
          "cameraPermission": "Wom Up needs access to your camera to take product photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2914feef-5f54-4157-b543-c428319fd864"
      }
    },
    "owner": "darshanthanki007"
  }
}
