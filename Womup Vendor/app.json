{
  "expo": {
    "name": "Womup Vendor",
    "slug": "womup-vendor",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/49446215-3cca-4522-8a2b-cc249807deff",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splashstorescreen.png",
      "resizeMode": "cover",
      "backgroundColor": "#071B52"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Womup Vendor needs access to photos to upload KYC documents and shop photos."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.womup.vendor",
      "infoPlist": {
        "NSCameraUsageDescription": "Womup Vendor needs camera access to capture shop and KYC documents.",
        "NSPhotoLibraryUsageDescription": "Womup Vendor needs photos access to upload KYC documents."
      }
    },
    "android": {
      "package": "com.womup.vendor",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05062A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "49446215-3cca-4522-8a2b-cc249807deff"
      }
    },
    "owner": "darshanthanki007"
  }
}
