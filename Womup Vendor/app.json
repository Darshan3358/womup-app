{
  "expo": {
    "name": "Womup Vendor",
    "slug": "womup-vendor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splashstorescreen.png",
      "resizeMode": "cover",
      "backgroundColor": "#071B52"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Womup Vendor needs access to photos to upload KYC documents and shop photos."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.womup.vendor",
      "infoPlist": {
        "NSCameraUsageDescription": "Womup Vendor needs camera access to capture shop and KYC documents.",
        "NSPhotoLibraryUsageDescription": "Womup Vendor needs photos access to upload KYC documents."
      }
    },
    "android": {
      "package": "com.womup.vendor",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05062A"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
